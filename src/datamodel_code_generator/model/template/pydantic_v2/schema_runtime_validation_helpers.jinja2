    @classmethod
    def _json_schema_conditional_equal(cls, value: Any, expected: Any) -> bool:
        match expected:
            case bool():
                return isinstance(value, bool) and value == expected
            case int() | float():
                return not isinstance(value, bool) and value == expected
            case dict():
                return (
                    (isinstance(value, dict) or isinstance(value, _Mapping))
                    and len(value) == len(expected)
                    and all(
                        key in value
                        and cls._json_schema_conditional_equal(value[key], item)
                        for key, item in expected.items()
                    )
                )
            case list():
                return (
                    isinstance(value, list)
                    and len(value) == len(expected)
                    and all(
                        cls._json_schema_conditional_equal(item, other)
                        for item, other in zip(value, expected, strict=True)
                    )
                )
        return value == expected
