    @classmethod
    def _validate_json_schema_unique_items(cls, data: Any) -> Any:
        if not (unique_item_paths := cls.__json_schema_unique_items__):
            return data
        for path in unique_item_paths:
            cls._validate_json_schema_unique_items_path(data, path, 0)
        return data

    @classmethod
    def _validate_json_schema_unique_items_path(
        cls,
        value: Any,
        path: tuple[object, ...],
        position: int,
    ) -> None:
        if position == len(path):
            cls._validate_json_schema_unique_array(value)
            return

        match path[position]:
            case None:
                if not isinstance(value, (list, tuple)):
                    return
                for item in value:
                    cls._validate_json_schema_unique_items_path(item, path, position + 1)
            case ('__json_schema_array_tail__', int() as start):
                if not isinstance(value, (list, tuple)) or start >= len(value):
                    return
                for index in range(start, len(value)):
                    cls._validate_json_schema_unique_items_path(value[index], path, position + 1)
            case int() as index:
                if isinstance(value, (list, tuple)) and index < len(value):
                    cls._validate_json_schema_unique_items_path(value[index], path, position + 1)
            case '__json_schema_mapping_values__':
                if not (isinstance(value, dict) or isinstance(value, _Mapping)):
                    return
                for item in value.values():
                    cls._validate_json_schema_unique_items_path(item, path, position + 1)
{%- if has_unique_items_regex_paths %}
            case ('__json_schema_mapping_pattern_values__', str() as pattern, None):
                if not (isinstance(value, dict) or isinstance(value, _Mapping)):
                    return
                for name, item in value.items():
                    if re.search(pattern, name):
                        cls._validate_json_schema_unique_items_path(item, path, position + 1)
            case ('__json_schema_mapping_additional_values__', tuple() as declared_name_groups, tuple() as patterns):
                if not (isinstance(value, dict) or isinstance(value, _Mapping)):
                    return
                for name, item in value.items():
                    for input_names in declared_name_groups:
                        for declared_name in input_names:
                            if declared_name in value:
                                break
                        else:
                            continue
                        if name == declared_name:
